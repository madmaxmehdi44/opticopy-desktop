<Window
    x:Class="OptiCopy.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OptiCopy Desktop">
    <Grid Background="{ThemeResource OptiBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="20,18,20,0"
                Padding="8"
                CornerRadius="16"
                Background="{ThemeResource OptiSurfaceBrush}"
                BorderBrush="{ThemeResource OptiCardBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{ThemeResource OptiCyanBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="OPTICOPY" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource OptiTextPrimaryBrush}" />
                    <TextBlock Text="OPTICAL TRANSFER" FontSize="11" CharacterSpacing="140" Foreground="{ThemeResource OptiTextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SendNavButton" Content="Send" Click="SendNavButton_Click" MinWidth="95" />
                    <Button x:Name="ReceiveNavButton" Content="Receive" Click="ReceiveNavButton_Click" MinWidth="95" />
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" Margin="0,14,0,0" />
    </Grid>
</Window>
