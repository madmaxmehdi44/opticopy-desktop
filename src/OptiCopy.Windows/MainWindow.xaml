<Window
    x:Class="OptiCopy.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OptiCopy Desktop">
    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="OptiCopy" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Optical file transfer" Opacity="0.7" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,0,8,0" MinHeight="160" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Send" FontSize="24" HorizontalAlignment="Center" />
                    <TextBlock Text="Display a QR stream" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Margin="8,0,0,0" MinHeight="160" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Receive" FontSize="24" HorizontalAlignment="Center" />
                    <TextBlock Text="Scan a QR stream" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
