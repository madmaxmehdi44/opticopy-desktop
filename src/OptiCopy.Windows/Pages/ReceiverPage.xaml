<Page
    x:Class="OptiCopy.Windows.Pages.ReceiverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource OptiBackgroundBrush}">
    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="RECEIVE FILE" FontSize="12" CharacterSpacing="180" FontWeight="SemiBold" Foreground="{ThemeResource OptiEmeraldBrush}" />
                <TextBlock Text="Optical receiver" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource OptiTextPrimaryBrush}" />
                <TextBlock Text="Capture the sender's QR stream and reconstruct the protected file." FontSize="14" Foreground="{ThemeResource OptiTextSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="StartCameraButton" Content="Start camera" Click="StartCamera_Click" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="150" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,18" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource OptiSurfaceBrush}" BorderBrush="{ThemeResource OptiCardBorderHighlightBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
                <Grid>
                    <Border Background="#0A111D" CornerRadius="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image x:Name="CameraImage" Stretch="Uniform" />
                    </Border>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" CornerRadius="12" Background="#990A111D">
                        <TextBlock x:Name="CameraOverlayLabel" Text="CAMERA OFF" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
                <Border Background="{ThemeResource OptiSurfaceBrush}" BorderBrush="{ThemeResource OptiCardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="CAMERA" FontSize="11" CharacterSpacing="160" Foreground="{ThemeResource OptiTextMutedBrush}" />
                        <ComboBox x:Name="CameraSelector" SelectionChanged="CameraSelector_SelectionChanged" PlaceholderText="Select camera" />
                        <TextBlock x:Name="CameraStatus" Text="Camera stopped" TextWrapping="Wrap" Foreground="{ThemeResource OptiTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource OptiSurfaceBrush}" BorderBrush="{ThemeResource OptiCardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="TRANSFER" FontSize="11" CharacterSpacing="160" Foreground="{ThemeResource OptiTextMutedBrush}" />
                        <TextBlock x:Name="FileNameLabel" Text="Waiting for stream" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource OptiTextPrimaryBrush}" />
                        <TextBlock x:Name="FileInfoLabel" Text="—" FontSize="12" Foreground="{ThemeResource OptiTextSecondaryBrush}" />
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" Height="8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressLabel" Text="0%" Foreground="{ThemeResource OptiTextPrimaryBrush}" />
                            <TextBlock x:Name="FrameLabel" Text="0 frames" Grid.Column="1" FontFamily="Consolas" Foreground="{ThemeResource OptiEmeraldBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource OptiSurfaceBrush}" BorderBrush="{ThemeResource OptiCardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="STATUS" FontSize="11" CharacterSpacing="160" Foreground="{ThemeResource OptiTextMutedBrush}" />
                        <TextBlock x:Name="StatusLabel" Text="READY" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource OptiTextPrimaryBrush}" TextWrapping="Wrap" />
                        <Button x:Name="SaveButton" Content="Save received file" Click="Save_Click" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Button x:Name="StopCameraButton" Content="Stop camera" Click="StopCamera_Click" IsEnabled="False" MinWidth="120" />
            <TextBlock Text="Decimen v3 • receiver resets automatically on sender session change" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource OptiTextMutedBrush}" />
        </Grid>
    </Grid>
</Page>
