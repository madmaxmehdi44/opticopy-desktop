<Application
    x:Class="OptiCopy.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="OptiObsidianDark">#0A0E17</Color>
                    <Color x:Key="OptiSlateBackground">#0F172A</Color>
                    <Color x:Key="OptiSurfaceDark">#161E2E</Color>
                    <Color x:Key="OptiSurfaceVariantDark">#1E293B</Color>
                    <Color x:Key="OptiSurfaceElevated">#243048</Color>
                    <Color x:Key="OptiNeonCyan">#00F0FF</Color>
                    <Color x:Key="OptiCyanGlow">#38BDF8</Color>
                    <Color x:Key="OptiNeonEmerald">#10B981</Color>
                    <Color x:Key="OptiEmeraldGlow">#34D399</Color>
                    <Color x:Key="OptiNeonAmber">#F59E0B</Color>
                    <Color x:Key="OptiElectricBlue">#3B82F6</Color>
                    <Color x:Key="OptiNeonPurple">#A855F7</Color>
                    <Color x:Key="OptiCyberRed">#EF4444</Color>
                    <Color x:Key="OptiTextPrimary">#F8FAFC</Color>
                    <Color x:Key="OptiTextSecondary">#94A3B8</Color>
                    <Color x:Key="OptiTextMuted">#64748B</Color>
                    <Color x:Key="OptiCardBorder">#334155</Color>
                    <Color x:Key="OptiCardBorderHighlight">#0284C7</Color>
                    <SolidColorBrush x:Key="OptiBackgroundBrush" Color="{StaticResource OptiObsidianDark}" />
                    <SolidColorBrush x:Key="OptiObsidianBrush" Color="{StaticResource OptiObsidianDark}" />
                    <SolidColorBrush x:Key="OptiSurfaceBrush" Color="{StaticResource OptiSurfaceDark}" />
                    <SolidColorBrush x:Key="OptiSurfaceVariantBrush" Color="{StaticResource OptiSurfaceVariantDark}" />
                    <SolidColorBrush x:Key="OptiSurfaceElevatedBrush" Color="{StaticResource OptiSurfaceElevated}" />
                    <SolidColorBrush x:Key="OptiCyanBrush" Color="{StaticResource OptiNeonCyan}" />
                    <SolidColorBrush x:Key="OptiCyanGlowBrush" Color="{StaticResource OptiCyanGlow}" />
                    <SolidColorBrush x:Key="OptiEmeraldBrush" Color="{StaticResource OptiNeonEmerald}" />
                    <SolidColorBrush x:Key="OptiAmberBrush" Color="{StaticResource OptiNeonAmber}" />
                    <SolidColorBrush x:Key="OptiTextPrimaryBrush" Color="{StaticResource OptiTextPrimary}" />
                    <SolidColorBrush x:Key="OptiTextSecondaryBrush" Color="{StaticResource OptiTextSecondary}" />
                    <SolidColorBrush x:Key="OptiTextMutedBrush" Color="{StaticResource OptiTextMuted}" />
                    <SolidColorBrush x:Key="OptiCardBorderBrush" Color="{StaticResource OptiCardBorder}" />
                    <SolidColorBrush x:Key="OptiCardBorderHighlightBrush" Color="{StaticResource OptiCardBorderHighlight}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="OptiObsidianDark">#F8FAFC</Color>
                    <Color x:Key="OptiSlateBackground">#E2E8F0</Color>
                    <Color x:Key="OptiSurfaceDark">#FFFFFF</Color>
                    <Color x:Key="OptiSurfaceVariantDark">#F1F5F9</Color>
                    <Color x:Key="OptiSurfaceElevated">#FFFFFF</Color>
                    <Color x:Key="OptiNeonCyan">#0284C7</Color>
                    <Color x:Key="OptiCyanGlow">#0EA5E9</Color>
                    <Color x:Key="OptiNeonEmerald">#059669</Color>
                    <Color x:Key="OptiEmeraldGlow">#10B981</Color>
                    <Color x:Key="OptiNeonAmber">#D97706</Color>
                    <Color x:Key="OptiElectricBlue">#2563EB</Color>
                    <Color x:Key="OptiNeonPurple">#9333EA</Color>
                    <Color x:Key="OptiCyberRed">#DC2626</Color>
                    <Color x:Key="OptiTextPrimary">#0F172A</Color>
                    <Color x:Key="OptiTextSecondary">#475569</Color>
                    <Color x:Key="OptiTextMuted">#64748B</Color>
                    <Color x:Key="OptiCardBorder">#CBD5E1</Color>
                    <Color x:Key="OptiCardBorderHighlight">#0284C7</Color>
                    <SolidColorBrush x:Key="OptiBackgroundBrush" Color="{StaticResource OptiObsidianDark}" />
                    <SolidColorBrush x:Key="OptiObsidianBrush" Color="{StaticResource OptiObsidianDark}" />
                    <SolidColorBrush x:Key="OptiSurfaceBrush" Color="{StaticResource OptiSurfaceDark}" />
                    <SolidColorBrush x:Key="OptiSurfaceVariantBrush" Color="{StaticResource OptiSurfaceVariantDark}" />
                    <SolidColorBrush x:Key="OptiSurfaceElevatedBrush" Color="{StaticResource OptiSurfaceElevated}" />
                    <SolidColorBrush x:Key="OptiCyanBrush" Color="{StaticResource OptiNeonCyan}" />
                    <SolidColorBrush x:Key="OptiCyanGlowBrush" Color="{StaticResource OptiCyanGlow}" />
                    <SolidColorBrush x:Key="OptiEmeraldBrush" Color="{StaticResource OptiNeonEmerald}" />
                    <SolidColorBrush x:Key="OptiAmberBrush" Color="{StaticResource OptiNeonAmber}" />
                    <SolidColorBrush x:Key="OptiTextPrimaryBrush" Color="{StaticResource OptiTextPrimary}" />
                    <SolidColorBrush x:Key="OptiTextSecondaryBrush" Color="{StaticResource OptiTextSecondary}" />
                    <SolidColorBrush x:Key="OptiTextMutedBrush" Color="{StaticResource OptiTextMuted}" />
                    <SolidColorBrush x:Key="OptiCardBorderBrush" Color="{StaticResource OptiCardBorder}" />
                    <SolidColorBrush x:Key="OptiCardBorderHighlightBrush" Color="{StaticResource OptiCardBorderHighlight}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Thickness x:Key="OptiCardPadding">22</Thickness>
            <CornerRadius x:Key="OptiCardRadius">18</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
